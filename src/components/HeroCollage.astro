---
import { getImage } from 'astro:assets';

// Cover fold built live: photo tiles on a pale ground with one huge white serif word on top (the word is cropped
// by the edges, like the other cases' covers). Drawn on a 2000 x 1091 canvas that scales like a cover photo.
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,png}');

interface Tile { name: string; x: number; y: number; w: number; h: number; pos?: string }
interface Props { heading: string; alt: string; word: string; caption: string; tiles: Tile[] }
const { heading, alt, word, caption, tiles } = Astro.props;

const placed = await Promise.all(tiles.map(async (t) => {
  const load = all[`../assets/${t.name}.jpg`] ?? all[`../assets/${t.name}.png`];
  if (!load) throw new Error(`Image not found: ${t.name}`);
  const src = (await load()).default;
  const img = await getImage({ src, width: t.w > 600 ? 1200 : 760, format: 'webp' });
  return { ...t, url: img.src };
}));
---
<section class="fold hero">
<h1 class="sr-only">{heading}</h1>
<svg class="hero-collage" viewBox="0 0 2000 1091" preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt} xmlns="http://www.w3.org/2000/svg">
<rect width="2000" height="1091" fill="#FAFAFA" />
{placed.map((t) => <image href={t.url} x={t.x} y={t.y} width={t.w} height={t.h} preserveAspectRatio={`${t.pos ?? 'xMidYMid'} slice`} />)}
<text x="1000" y="825" text-anchor="middle" class="hero-word">{word}</text>
<text x="1000" y="885" text-anchor="middle" class="hero-caption">{caption}</text>
</svg>
</section>
