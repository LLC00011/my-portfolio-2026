---
// A small black canoe with a stick figure paddling along the waterline of the iceberg. Decorative.
// The paddle swings round the lower hand and the other arm follows it (SMIL, same timing); the canoe drifts
// across the page in CSS and leaves ripples at the stern.
---
<div class="boat" aria-hidden="true">
<svg viewBox="0 0 96 44" xmlns="http://www.w3.org/2000/svg">
<g class="ripples" fill="none" stroke="#0B0B14" stroke-width="0.9">
<ellipse cx="2" cy="32" rx="5" ry="1.3" />
<ellipse cx="2" cy="32" rx="5" ry="1.3" />
<ellipse cx="2" cy="32" rx="5" ry="1.3" />
</g>
<g fill="none" stroke="#0B0B14" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
<circle cx="49" cy="7" r="4" fill="#FAFAFA" />
<path d="M48 12.5 L47 24 L56 22 L61 25" />
<line x1="48" y1="12.5" x2="51" y2="17" />
<line x1="48" y1="12.5" x2="49.37" y2="5.41">
<animate attributeName="x2" values="49.37;58.52;49.37" keyTimes="0;0.55;1" calcMode="spline" keySplines="0.4 0 0.6 1;0.4 0 0.6 1" dur="2.4s" repeatCount="indefinite" />
<animate attributeName="y2" values="5.41;8.03;5.41" keyTimes="0;0.55;1" calcMode="spline" keySplines="0.4 0 0.6 1;0.4 0 0.6 1" dur="2.4s" repeatCount="indefinite" />
</line>
<g>
<animateTransform attributeName="transform" type="rotate" values="-28 51 17;20 51 17;-28 51 17" keyTimes="0;0.55;1" calcMode="spline" keySplines="0.4 0 0.6 1;0.4 0 0.6 1" dur="2.4s" repeatCount="indefinite" />
<line x1="55" y1="6" x2="43" y2="39" stroke-width="1.4" />
<line x1="45.4" y1="33.5" x2="42.2" y2="40" stroke-width="3.8" stroke-linecap="butt" />
</g>
</g>
<path d="M3 19 Q12 25 24 25 L72 25 Q84 25 93 19 Q89 35 70 36 L26 36 Q7 35 3 19 Z" fill="#0B0B14" />
</svg>
</div>
<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.boat svg').forEach((s) => (s as SVGSVGElement).pauseAnimations());
  }
</script>
