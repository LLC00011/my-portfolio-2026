---
// Navigation pill: home logo, Works and About me, and on case pages the scroll arrow. At the end of a case the
// previous case shows up next to the next one.
interface Props {
  current: 'works' | 'about';
  next?: { href: string; label: string };
  prev?: { href: string; label: string };
}
const { current, next, prev } = Astro.props;
---
<nav class="pill" aria-label="Main">
<a class="logo" href="index.html" aria-label="Home"><svg viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="42" height="42" fill="#0B0F1C"/><path d="M14.4832 13.1917L11.1548 28.8083H12.2736H19.238L19.5923 27.1796H13.411L16.3851 13.1917H14.4832Z" fill="#F4F4F4"/><path d="M22.762 13.1917L22.3984 14.8203H28.589L25.6149 28.8083H27.5075L30.8452 13.1917H22.762Z" fill="#F4F4F4"/></svg></a>
<div class="ic">
<a class="ic-link" href="index.html" aria-label="Works" aria-current={current === 'works' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.4l9 4.5-9 4.5-9-4.5z"/><path d="M3 11.8l9 4.5 9-4.5"/><path d="M3 15.3l9 4.5 9-4.5"/></svg></a>
<span class="tip" aria-hidden="true">Works</span>
</div>
<div class="ic">
<a class="ic-link" href="about.html" aria-label="About me" aria-current={current === 'about' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="6.6" r="4.5"/><path d="M1.6 21c0-3.2 2.3-5.9 5.6-7.2M22.4 21c0-3.2-2.3-5.9-5.6-7.2M1.6 21h20.8"/></svg></a>
<span class="tip" aria-hidden="true">About me</span>
</div>
{next && prev && (
<div class="prevwrap" id="prev-wrap">
<a class="prev" id="prev" href={prev.href} aria-label={`Previous case: ${prev.label}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a>
<span class="tip" aria-hidden="true">← {prev.label}</span>
</div>
)}
{next && (
<div class="gowrap" id="go-wrap">
<a class="go" id="go" href={next.href} data-case={next.label} aria-label="Next section" aria-keyshortcuts="ArrowDown ArrowRight"><svg class="ring" viewBox="0 0 48 48" aria-hidden="true"><circle class="ring-track" cx="24" cy="24" r="23"/><circle class="ring-bar" cx="24" cy="24" r="23"/></svg><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
<span class="tip" aria-hidden="true">{next.label}</span>
</div>
)}
</nav>
