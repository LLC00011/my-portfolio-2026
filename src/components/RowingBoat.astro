---
// A small black boat with a stick figure rowing along the waterline of the iceberg. Decorative.
// The oar swings and the arm follows it (SMIL, same timing); the boat drifts across the page in CSS.
---
<div class="boat" aria-hidden="true">
<svg viewBox="0 0 84 44" xmlns="http://www.w3.org/2000/svg">
<g fill="none" stroke="#0B0B14" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
<circle cx="43" cy="7" r="4" fill="#FAFAFA" />
<path d="M42 12.5 L41 20 L31 21 L26 23" />
<line x1="42" y1="12.5" x2="35.33" y2="15.34">
<animate attributeName="x2" values="35.33;33.07;35.33" keyTimes="0;0.5;1" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1" dur="2s" repeatCount="indefinite" />
<animate attributeName="y2" values="15.34;19.86;15.34" keyTimes="0;0.5;1" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1" dur="2s" repeatCount="indefinite" />
</line>
<g>
<animateTransform attributeName="transform" type="rotate" values="10 47 24;-10 47 24;10 47 24" keyTimes="0;0.5;1" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1" dur="2s" repeatCount="indefinite" />
<line x1="34" y1="17.5" x2="67" y2="34" stroke-width="1.4" />
<line x1="63" y1="32" x2="69" y2="35" stroke-width="3.2" />
</g>
</g>
<path d="M6 24 L78 24 Q73 37 58 37 L26 37 Q11 37 6 24 Z" fill="#0B0B14" />
</svg>
</div>
<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.boat svg').forEach((s) => (s as SVGSVGElement).pauseAnimations());
  }
</script>
