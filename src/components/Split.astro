---
import Img from './Img.astro';

// Image on one side, title, lead and copy on the other. Slots: title, lead, the default slot (copy) and an optional
// visual slot that stands in for the image (a diagram on a grey ground).
interface Props {
  image?: string;
  alt?: string;
  pos?: string;
  pw?: number;
  rev?: boolean;
  padR?: boolean;
  narrow?: boolean | 's';
  h1?: boolean;
  infoStyle?: string;
  snug?: boolean;
  placeholder?: string;
}
const { image, alt = '', pos = '50% 50%', pw = 57.3, rev = false, padR = false, narrow = false, h1 = false, infoStyle, placeholder, snug = false } = Astro.props;
const Tag = h1 ? 'h1' : 'h2';
const titleClass = 'h' + (narrow === 's' ? ' narrow-s' : narrow ? ' narrow' : '');
---
<section class:list={['fold', 'split', { splitr: rev }]}>
<div class="photo" style={`flex: 0 0 ${pw}%`}>
{image
  ? <Img name={image} alt={alt} style={`object-position: ${pos}`} sizes="(min-width: 1180px) 60vw, 100vw" />
  : Astro.slots.has('visual')
    ? <div class="vis"><slot name="visual" /></div>
    : <div class="ph fill" role="img" aria-label={alt || 'Image placeholder'}>{placeholder}</div>}
</div>
<div class:list={['info', { 'pad-r': padR, snug }]} style={infoStyle}>
<div class="head">
<Tag class={titleClass}><slot name="title" /></Tag>
<p class="sans lead"><slot name="lead" /></p>
</div>
<div class="serif copy"><slot /></div>
</div>
</section>
